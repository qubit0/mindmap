# Copy this file to `.env` and set DATABASE_URL, then run `bun run db:push`.
#
#   cp .env.example .env
#
# Use an ABSOLUTE path. Prisma resolves relative SQLite paths against the
# `prisma/` directory (not the project root), so `file:./db/custom.db` would
# silently create its database at `prisma/db/custom.db`.
#
# The database file ships in this repo at `db/custom.db`.
# Replace /path/to/mindmap below with the absolute path to your clone.

DATABASE_URL=file:/path/to/mindmap/db/custom.db
